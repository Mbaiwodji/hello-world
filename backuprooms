@Transactional
	public Etude updateEtude(EtudeDto etudeDto) {
		Etude oldEtude = this.etudeRepository.getDetailEtude(etudeDto.getItEtude());

		setOldEtude(oldEtude, etudeDto);

		if (oldEtude.getAgent() == null) {
			Agent agent = this.agentService.findByImmat(etudeDto.getImmat());
			if (agent == null) {
				oldEtude.setAgent(AgentMapper.INSTANCE.mapToAgent(etudeDto.getAgentDto()));
			} else {
				oldEtude.setAgent(agent);
			}
		}
		if (StatutEtude.INITIER.equals(oldEtude.getStatut())) {
			this.decisionService.oldDecision(oldEtude);
			oldEtude.setEtat(EtatEtude.ATTENTE_REPONSE.getCode());
			oldEtude.setStatut(StatutEtude.EN_COURS.getCode());
			this.decisionService.newDecision(oldEtude);
		}
		return this.etudeRepository.save(oldEtude);
	}

