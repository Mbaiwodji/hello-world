        verify(etudeRepository, times(1)).save(any(Etude.class));
        assertNotNull(result);
    }

    @Test
    public void testUpdateEtude_OptimisticLockingFailure() {
        // Set up the entity version to simulate an optimistic lock failure
        etude.setVersion(1L); // Entity version before update
        etudeDto.setVersion(2L); // The DTO version is out-of-sync

        // Mock the repository to return the Etude entity when fetched
        when(etudeRepository.getDetailEtude(1L)).thenReturn(etude);

