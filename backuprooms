  const [day, month, year] = effectDate.split("-").map(Number);
  const effectDateObj = new Date(year, month - 1, day); // Convert to Date object

  const today = new Date();
  
  // Compare effectDate with today's date
  return effectDateObj < today; // Returns true if effectDate is in the past
}

