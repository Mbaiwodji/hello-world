searchTransactions(query: string, dateRange?: {start: Date, end: Date}): Observable<Transaction[]> {
  const params = new HttpParams()
    .set('query', query)
    .set('startDate', dateRange?.start.toISOString() || '')
    .set('endDate', dateRange?.end.toISOString() || '');

  return this.http.get<Transaction[]>('/api/rit/search', { params });
}
