    }

    @Test
    public void testUpdateEtude_SuccessfulUpdate() {
        // Mock the repository to return the Etude entity when fetched
        when(etudeRepository.getDetailEtude(1L)).thenReturn(etude);
        when(etudeRepository.save(any(Etude.class))).thenReturn(etude);

        // Mock other service methods as needed (e.g., agentService, decisionService)
