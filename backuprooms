package com.example.fileservice.service;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.nio.file.*;
import java.util.Comparator;
import java.util.Optional;
import java.util.stream.Stream;

@Service
public class FileService {

    @Value("${file.directory.path}") // Injected from application.properties
    private String directoryPath;

    /**
     * Finds the latest file with a name starting with "Toto_"
     * @return Optional<String> with the latest file name
     */
    public Optional<String> findLatestFile() {
        try (Stream<Path> files = Files.list(Paths.get(directoryPath))) {
            return files
                .filter(path -> path.getFileName().toString().startsWith("Toto_")) // Filter files
                .max(Comparator.comparingLong(path -> path.toFile().lastModified())) // Get the most recent file
                .map(path -> path.getFileName().toString());
        } catch (IOException e) {
            throw new RuntimeException("Error reading files in directory: " + directoryPath, e);
        }
    }
}
